# Atlas-Bot production environment template — NOT a deployable secret file.
# Supply real values through the deployment platform / Secret Manager.
# Do not commit filled-in .env files. This template deliberately keeps every live-money path disabled.

ENVIRONMENT=production
PROCESS_ROLE=api

# Use managed PostgreSQL; replace placeholders before deployment.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-host>:5432/<database>
ATLAS_POSTGRES_URL=postgresql+asyncpg://<user>:<password>@<postgres-host>:5432/<database>

# Required secrets: inject from Secret Manager, never use these placeholder strings.
SECRET_KEY=<inject-random-secret>
APP_ENCRYPTION_KEY=<inject-generated-fernet-key>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<inject-supabase-anon-key>
FUNDING_WEBHOOK_SECRET=<inject-random-webhook-secret>
FORWARDED_ALLOW_IPS=<trusted-proxy-cidr-only>

# Production controls: keep enabled.
ADMIN_TOTP_REQUIRED=true
CUSTOMER_TOTP_REQUIRED=true
WITHDRAWAL_DUAL_APPROVAL=true
DISTRIBUTED_RATE_LIMIT_REQUIRED=true
REQUIRE_BACKUP_RECOVERY_CONFIG=true
BACKUP_RECOVERY_URL=https://<approved-backup-recovery-endpoint>
EXTERNAL_SECURITY_AUDIT_ENABLED=true
EXTERNAL_SECURITY_AUDIT_REQUIRED=true

# Shared rate limiting and operational recovery.
REDIS_URL=rediss://<managed-redis-host>:<port>/0

# Release identity must be injected by the deployment pipeline.
RELEASE_SHA=<immutable-commit-sha>
RELEASE_VERSION=3.10.47
IMAGE_DIGEST=sha256:<64-hex-character-image-digest>

# Explicit fail-closed financial posture. Do not change for a routine deployment.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
CUSTOMER_LIVE_TRADING_ENABLED=false
BROKER_SANDBOX=true
PAYOUT_LIVE_ENABLED=false
DERIV_LIVE_ENABLED=false
USDT_TRON_ENABLED=false
