# Local development defaults. Production values live in deploy/cloud-run.env.example and
# deploy/supabase.env.example; keep real secrets in a secret manager, never in this file.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
BROKER_SANDBOX=true
DOCS_ENABLED=false
PAYOUT_PROVIDER=disabled
PAYOUT_LIVE_ENABLED=false

# Customer sign-in uses Supabase Auth.
SUPABASE_URL=
SUPABASE_JWKS_URL=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
