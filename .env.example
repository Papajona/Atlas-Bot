APP_ENCRYPTION_KEY=
BROKER_SANDBOX=
DATABASE_URL=
# Customer paper stays disabled until its dedicated role/schema preflight passes.
CUSTOMER_PAPER_LEDGER_ENABLED=false
CUSTOMER_PAPER_DATABASE_URL=
# Optional free single-project schema isolation; explicit opt-in only after review.
CUSTOMER_PAPER_SHARED_DATABASE_ENABLED=false
# Virtual starting balance only; this is not a deposit or withdrawable money.
CUSTOMER_PAPER_INITIAL_BALANCE=10000.0
CUSTOMER_PAPER_INITIAL_CURRENCY=USDT
DOCS_ENABLED=
EDGE_DECAY_HALT_ENABLED=
ENVIRONMENT=
INITIAL_EQUITY=
LIVE_TRADING_ENABLED=false
CUSTOMER_LIVE_TRADING_ENABLED=false
BROKER_SANDBOX=true
RISK_PER_TRADE=
PAPER_TRADING=true
PAYOUT_LIVE_ENABLED=false
PAYOUT_PROVIDER=
RESEARCH_COST_STRESS_MULTIPLIER=
RESEARCH_MIN_DEFLATED_SHARPE=
RESEARCH_REQUIRE_COST_STRESS=
SUPABASE_JWKS_URL=
SUPABASE_URL=
# Optional server-side OpenAI-compatible gateway for admin release diagnostics.
# Keep the key in server Secret Manager; never put it in Android resources/build config.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=
# Optional Cerebras inference backup. Store the key in Secret Manager; never commit it.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# --- Withdrawal hardening (3.10.48 patch) ---
# Name of the exchange-native client/withdraw-order-id parameter. Leave EMPTY until you have verified,
# on that exchange's TESTNET, that the exchange stores the id and returns it in withdrawal history.
# Even when configured, bounded CCXT history absence remains UNKNOWN; this parameter enables positive matching only.
PAYOUT_CLIENT_ID_PARAM=
PAYOUT_RECOVERY_LOOKBACK_HOURS=72
# Minutes a SUBMITTING withdrawal with no provider id must age before mark-not-sent may resolve it.
WITHDRAWAL_STALE_SUBMITTING_MINUTES=15
# Minutes a live-trading enable REQUEST stays approvable.
LIVE_ENABLE_REQUEST_TTL_MINUTES=15
# Platform-only paper fills; assumptions are uncalibrated and verified spot liquidity is required.
PAPER_FILL_LATENCY_BARS=1
PAPER_ORDER_TTL_BARS=24
PAPER_MAX_BAR_VOLUME_PARTICIPATION=0.10
PAPER_QUEUE_FILL_PROBABILITY=0.80
PAPER_REJECTION_PROBABILITY=0.01
PAPER_MARKET_IMPACT_COEFFICIENT=0.10
PAPER_MAX_MARKET_IMPACT_BPS=250.0
