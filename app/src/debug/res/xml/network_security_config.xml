<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug variants may connect to an explicitly configured local/staging HTTP backend. -->
    <!-- The main/release resource retains cleartextTrafficPermitted=false. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
