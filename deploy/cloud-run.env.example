APP_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_AND_STORE_IN_SECRET_MANAGER
ENVIRONMENT=production
PROCESS_ROLE=api
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
BROKER_SANDBOX=true
DOCS_ENABLED=false
METRICS_ENABLED=true
METRICS_REQUIRE_ADMIN=true
BACKGROUND_RECONCILIATION_ENABLED=true
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require

USDT_TRON_ENABLED=true
USDT_TRON_NETWORK=mainnet
USDT_TRONGRID_BASE_URL=https://api.trongrid.io
USDT_TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
USDT_TRON_POLL_SECONDS=60
USDT_TRON_MIN_CONFIRMATIONS=19
# Store these in Google Secret Manager; do not put them in a .env committed to source.
USDT_TRON_ACCOUNT_XPUB=<public-account-level-tron-xpub>
TRONGRID_API_KEY=<your-TronGrid-key>

# Fresh OTP step-up required for customer withdrawals
WITHDRAWAL_STEP_UP_MINUTES=10

# Admin security: Supabase Auth + Google Authenticator (TOTP) is required in production.
ADMIN_TOTP_REQUIRED=true
# Comma-separated Supabase Auth user UUIDs authorized for admin console/API.
ADMIN_SUPABASE_USER_IDS=
# Optional explicit server-side RBAC: uuid:ROLE,uuid:ROLE
ADMIN_ROLE_ASSIGNMENTS=
WITHDRAWAL_ADDRESS_COOLING_OFF_HOURS=24
WITHDRAWAL_NEW_ADDRESS_REQUIRES_VERIFICATION=true

# Atlas Strategy Intelligence (real LLM; never grants execution authority)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_STRATEGY_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STRATEGY_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=4096

# Paper promotion requires forward/OOS evidence in addition to in-sample metrics.
RESEARCH_MIN_OOS_TOTAL_RETURN=0.0
RESEARCH_MIN_OOS_POSITIVE_FOLD_RATIO=0.5

FORWARDED_ALLOW_IPS=
MODEL_SIGNING_PUBLIC_KEY=
MODEL_SIGNING_PRIVATE_KEY=

SUPABASE_ANON_KEY=
FUNDING_WEBHOOK_SECRET=
