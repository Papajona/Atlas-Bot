# SQLAlchemy async PostgreSQL URL from Supabase.
# Prefer the Supavisor/session pooler for the Cloud Run service if required by project limits.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres?ssl=require

# Supabase Auth is the customer identity provider. Keep the service-role key server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=
SUPABASE_AUTH_AUDIENCE=authenticated
FUNDING_WEBHOOK_SECRET=
